# ==============================================================================
# BorderGuard AI - Unified Configuration
# ==============================================================================

# Backend Settings
PROJECT_NAME="BorderGuard AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security & Authentication
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY="super-secret-security-operations-center-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Internal AI Service Secret (Shared between AI Engine & Backend)
AI_SERVICE_SECRET="ai-engine-internal-hmac-secret-key-987654"

# Database Configuration
# Default to SQLite for zero-setup local execution:
DATABASE_URL="sqlite+aiosqlite:///./borderguard.db"
# For PostgreSQL (Docker or Production):
# DATABASE_URL="postgresql+asyncpg://borderguard:borderguard_secret@localhost:5432/borderguard_db"

# Storage Settings
STORAGE_DIR="./storage"
SNAPSHOT_DIR="./storage/snapshots"
CLIP_DIR="./storage/clips"
MAX_EVIDENCE_SIZE_MB=5000

# CORS Origins (Comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# AI Engine Telemetry & Processing
DEFAULT_MODEL_NAME="yolov8n.pt"
CONFIDENCE_THRESHOLD=0.50
IOU_THRESHOLD=0.45
DWELL_TIME_SECONDS=1.5
TRACK_COOLDOWN_SECONDS=30
FRAME_SKIP_INTERVAL=2
MOCK_STREAM_PATH="./ai-engine/sample_data/border_patrol.mp4"

# Roboflow Serverless Cloud API Settings
# Get your API key from: https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=""
ROBOFLOW_MODEL_ID="people-detection-o4rdr-3yyvd/1"
ROBOFLOW_API_URL="https://serverless.roboflow.com"
DETECTION_ENGINE="yolo"  # Options: yolo | roboflow
