# ==============================================================================
# BorderGuard AI - Comprehensive .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Credentials (NEVER COMMIT!)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets.json

# ------------------------------------------------------------------------------
# 2. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ------------------------------------------------------------------------------
# 3. Node.js & React Frontend
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/coverage/

# ------------------------------------------------------------------------------
# 4. Database & Temporary Storage
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
borderguard.db

# Dynamic Evidence Snapshots & Video Clips
storage/snapshots/*
!storage/snapshots/sample_evidence_104.jpg
!storage/snapshots/ev_104.jpg
!storage/snapshots/.gitkeep
storage/clips/*
!storage/clips/.gitkeep

# AI model weight binary checkpoints (*.pt, *.pth, *.onnx) - keep only core best.pt
ai-engine/models/*.onnx
ai-engine/models/*.engine
ai-engine/models/*.pth
ai-engine/models/*.pt
!ai-engine/models/best.pt
backend/*.pt
*.pt
!yolov8n.pt
ai-engine/models/rf_detr_large/
ai-engine/models/videomae_violence/
runs/
**/runs/
scratch/
**/scratch/
*.part
*.zip
Dataset/

# ------------------------------------------------------------------------------
# 5. Operating System & IDE Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
